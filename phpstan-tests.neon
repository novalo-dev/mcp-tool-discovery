parameters:
    # Tests read decoded JSON answers, mixed by nature: level 6 keeps types
    # and signatures checked without an assertion per array offset.
    level: 6
    phpVersion: 80100
    paths:
        - tests
    excludePaths:
        # Read with Symfony installed, by its own job: without it, the
        # kernel and the request of the test are unknown here.
        - tests/Symfony
        # The same for Laravel, and for laravel/mcp.
        - tests/Laravel
        - tests/LaravelMcp
