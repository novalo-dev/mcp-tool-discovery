includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    # The highest level for the library itself: it is small, has no framework
    # to excuse a loose type, and every host relies on its contracts. The
    # examples are held to it too, since hosts copy them.
    level: max
    phpVersion: 80100
    paths:
        - src
        - bin
        - docs/examples
    excludePaths:
        # Read with the SDK, ReactPHP, Symfony or Laravel installed, by their
        # own jobs: without them, every class of mcp/sdk, react/http, Symfony
        # or Laravel is unknown here.
        - docs/examples/sdk
        - docs/examples/react
        - docs/examples/symfony
        - docs/examples/laravel
