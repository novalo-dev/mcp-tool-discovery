{
    "name": "example/notes-sdk-server",
    "description": "The notes server on the official MCP PHP SDK, with its tools shown through novalo/mcp-tool-discovery.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "mcp/sdk": "0.10.0",
        "novalo/mcp-tool-discovery": "*@dev",
        "nyholm/psr7": "^1.8",
        "symfony/finder": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Example\\Notes\\Sdk\\Tools\\": "tools/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../.."
        }
    ],
    "config": {
        "sort-packages": true
    }
}
